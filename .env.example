# Copy to `.env.local` and edit. Vite only exposes variables prefixed with VITE_.

# Instructor Mode passcode (convenience lock only — it ships inside the client
# bundle and is NOT a security control). Default if unset: 2468
VITE_INSTRUCTOR_PASSCODE=2468

# URL (relative to the site root) of the compiled MindAR image target.
VITE_MARKER_TARGET_URL=marker/targets.mind

# Physical printed width of the marker in centimetres (used to convert
# MindAR marker units into centimetres for calibration).
VITE_MARKER_SIZE_CM=12

# Anatomy model source: "procedural" (default) or "gltf".
VITE_MODEL_SOURCE=procedural
# Used only when VITE_MODEL_SOURCE=gltf (see README "Replacing the procedural model").
VITE_MODEL_GLTF_URL=models/right-index-finger.glb
