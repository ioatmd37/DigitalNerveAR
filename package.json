{
  "name": "digital-nerve-block-ar-trainer",
  "private": true,
  "version": "0.1.0",
  "description": "Marker-based WebAR educational trainer for a digital nerve block on a right-hand mannequin (educational simulation only).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "dev:https": "vite --host --mode https",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host --mode https",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "marker:build": "node scripts/build-marker.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "mind-ar": "^1.2.5",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "playwright-core": "^1.55.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "canvas": "npm:empty-npm-package@1.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0"
  }
}
